@page "/admin"
@attribute [Authorize(Roles="Admin")]
@inherits LocalizedComponent
@inject ContestStore Store
<PageTitle>@Ui["admin.dashboard"] · BeastContest</PageTitle>
<div class="page-heading"><h1>@Ui["admin.dashboard"]</h1><p>@Ui["admin.dashboardHint"]</p></div>
<div class="admin-actions">
<a class="panel admin-action" href="/admin/contests/new"><Icon Name="trophy"/><h2>@Ui["nav.admin"]</h2><p>@Ui["admin.contestHint"]</p></a>
<a class="panel admin-action" href="/admin/problems/new"><Icon Name="code"/><h2>@Ui["problem.new"]</h2><p>@Ui["admin.problemHint"]</p></a>
<a class="panel admin-action" href="/admin/users"><Icon Name="users"/><h2>@Ui["users.title"]</h2><p>@Ui["admin.usersHint"]</p></a>
<a class="panel admin-action" href="/chat"><Icon Name="code"/><h2>@Ui["chat.adminTitle"]</h2><p>@Ui["admin.chatHint"]</p></a>
</div>
<p><a class="button secondary" href="/admin/judge"><Icon Name="server"/>@Ui["queue.title"]</a></p>
<section id="contests" class="catalog"><div class="catalog-heading"><div><h2>@Ui["contests.title"] <span class="count">@_contests.Length</span></h2><p>@Ui["contests.subtitle"]</p></div><AuthorizeView Roles="Admin"><a class="button secondary" href="/admin/contests/new"><Icon Name="plus" />@Ui["home.create"]</a></AuthorizeView></div>
<div class="catalog-toolbar"><div class="tabs" role="group" aria-label="@Ui["contests.title"]">@foreach(var tab in new[]{"all","demo","drafts"}) { <button class="@(_filter == tab ? "active" : "")" @onclick="() => _filter = tab">@Ui["contests." + tab]</button> }</div><div class="search"><Icon Name="search" /><input aria-label="@Ui["contests.search"]" placeholder="@Ui["contests.search"]" @bind="_query" @bind:event="oninput" /></div></div>
@if (_error) { <div class="notice">@Ui["common.error"] <button class="button secondary" @onclick="LoadAsync">@Ui["common.retry"]</button></div> }
else if (_loading) { <p>@Ui["common.loading"]</p> }
else { <div class="contest-grid">@foreach(var contest in Filtered) { <ContestCard Contest="contest" /> }</div>@if(!Filtered.Any()) { <div class="empty panel"><Icon Name="search" /><h3>@Ui["contests.empty"]</h3><p>@Ui["contests.emptyHint"]</p></div> } }
</section>
@code {
    private Contest[] _contests = [];
    private string _query = "", _filter = "all";
    private bool _loading = true, _error;
    private IEnumerable<Contest> Filtered => _contests.Where(c => (_filter == "all" || (_filter == "demo" ? c.IsDemo : c.Status == ContestStatus.Draft)) && Ui.Text(c.Title).Contains(_query, StringComparison.OrdinalIgnoreCase));
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() { _loading = true; _error = false;
        try { _contests = await Store.GetAllAsync(); }
        catch(Exception ex) when(ex is System.Data.Common.DbException or InvalidOperationException) { _error = true; }
        finally { _loading = false; }
    }
}



